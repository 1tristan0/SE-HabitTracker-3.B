@startuml
actor Nutzer as user
participant "HabitChangeModal" as modal
participant "HabitsPage" as site
participant "Backend API" as backend
participant "PrismaORM" as prisma
participant "Database(Supabase)" as database
user -> modal: edits habit (Name, description) in HabitChangeModal
modal-> site: handleSave(habit.id, { name, description })
site -> backend: updateHabit(token, id, { name, description, start_date })
backend -> prisma: PUT /api/habits/${id} 
prisma -> database: Update Habit row
database --> backend: OK
prisma --> backend: Updated Habit-Data
backend --> site: 200 OK with updated Habit-Data
site --> user: Shows updated Habit-Data in the UI
@enduml