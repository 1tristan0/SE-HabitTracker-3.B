== 2 Container-Diagramm

[plantuml, containerdiagram, svg]
----
@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(user, "Nutzer", "Möchte seine Habits tracken")
System_Boundary(gewohnheitstier, "Gewohnheitstier") {
  Container(webApp, "Web-Frontend", "React", "UI für Nutzerinteraktion")
  Container(api,    "Backend API", "Node.js/Express.js", "Verarbeitet Anfragen und führt Logik aus")



ContainerDb(db,    "Database(Supabase)",  "PostgreSQL", "Datenspeicherung")
}

Rel(user, webApp, "nutzt")
Rel(webApp,    api,    "REST-Calls")
Rel_R(api,       db,     "Kommunikation über ORM")

@enduml
----

== 3 Komponenten-Diagramm
[plantuml, containerdiagram, svg]
----
@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Person(user, "Nutzer")

System_Boundary(frontend, "Web Frontend - React") {
  Component(app, "App.jsx", "React Root + Routes", "Router mit Routes / Login/Signup Handler")
  Component(login, "Login", "React Component", "Login-Seite")
  Component(signup, "Signup", "React Component", "Registrierungs-Seite")
  
  Component(habitsPage, "HabitsPage", "React Component", "Zeigt Habits & Kalender & Begleiter")
  Component(createHabit, "CreateHabitPage", "React Component", "Formular zur Habit-Erstellung")
  Component(navbar, "Navbar", "React Component", "Header mit Logout")
  
  Component(habitGrid, "Habit Grid Component", "React Component", "Mapping aller Habits des Users")
  Component(habitCard, "Habit Card Component", "React Component", "Anzeige eines Habits mit ToggleSwitch")
  Component(toggleSwitch, "ToggleSwitch", "Reusable UI", "Ein/Aus-Schalter für Habits")
  Component(calendar, "Calendar Component", "React", "Kalenderdarstellung der Streaks mit Tagesbuttons")
  Component(habitForm, "HabitCreateContent", "React", "Wiederverwendbares Formular")
  
  Component(editHabit, "HabitChangeModal", "React Component", "Modal zur Habit-Bearbeitung")
  Component(habitInfoModal, "HabitInfoModal", "React Component", "Modal zur Anzeige von Habit-Details")
  Component(calendarModal, "CalendarModal", "React Component", "Modal für Tagesdetails")
  
  Component(animal, "Animal Component", "React Component", "Anzeige des Gewohnheitstiers")
  Component(animalModal, "Animal Modal", "React Component", "Modal zur Auswahl des Tiers")
  
  Component(uiPrimitives, "UI Primitives", "Shared UI", "ProgressCircle, StreakBadge, Modal, Buttons")
  
  Component(habitService, "Habit Service", "API Client", "Kommunikation mit Backend (habitsApi.js)")
  Component(authService, "Auth Service", "API Client", "Authentifizierung & Session (authApi.js)")
  Component(userService, "User Service", "API Client", "Nutzer-Daten & Tier (userApi.js)")
}

System_Boundary(backend, "Backend API - Node.js/Express") {
  Component(authRoute, "Auth Routes", "Express Router", "Login/Signup/Logout Endpoints")
  Component(habitRoute, "Habit Routes", "Express Router", "CRUD Endpoints für Habits")
  
  Component(authController, "Auth Controller", "Middleware", "Auth-Logik & JWT-Handling")
  Component(habitController, "Habit Controller", "Express Handler", "Geschäftslogik für Habits")
  
  Component(habitModel, "Habit Model", "Prisma Schema", "Datenstruktur & Validierung")
  Component(userModel, "User Model", "Prisma Schema", "User-Datenstruktur")
  
  Component(prismaClient, "Prisma Client", "ORM", "Datenbank-Zugriff")
}

System_Boundary(database, "Supabase") {
  ComponentDb(habitTable, "habits", "PostgreSQL Table", "Speichert Habit-Daten")
  ComponentDb(userTable, "users", "PostgreSQL Table", "Speichert User-Daten & Auth")
}

Rel(user, app, "nutzt")
Rel(app, login, "zeigt bei unauthentifiziert")
Rel(app, signup, "zeigt bei Registrierung")
Rel(app, navbar, "zeigt nach Login")
Rel(app, habitsPage, "Route: /")
Rel(app, createHabit, "Route: /add")
Rel(navbar, app, "Logout-Trigger")

Rel(habitsPage, habitGrid, "verwendet")
Rel(habitsPage, calendar, "verwendet")
Rel(habitsPage, animal, "zeigt Begleiter")
Rel(habitsPage, habitService, "lädt/bearbeitet Habits")
Rel(habitsPage, userService, "lädt Tier-Daten")

Rel(animal, animalModal, "öffnet bei Klick")
Rel(animalModal, userService, "speichert Tier-Auswahl")

Rel(createHabit, habitForm, "verwendet")
Rel(habitForm, habitService, "erstellt Habit")

Rel(calendar, calendarModal, "zeigt bei Tages-Klick")

Rel(habitGrid, habitCard, "rendert Habits")
Rel(habitCard, toggleSwitch, "verwendet zum Toggle")
Rel(habitCard, habitInfoModal, "nach Info-Klick")
Rel(habitCard, editHabit, "nach Edit-Klick")
Rel(habitCard, habitService, "delete/toggle")

Rel(editHabit, habitService, "speichert Update")
Rel(habitForm, uiPrimitives, "nutzt Buttons/InputField")
Rel(habitCard, uiPrimitives, "nutzt ProgressCircle/StreakBadge")

Rel(login, authService, "nutzt")
Rel(signup, authService, "nutzt")
Rel(habitService, authService, "sendet Token")
Rel(userService, authService, "sendet Token")

Rel(habitService, habitRoute, "HTTP GET/POST/PUT/DELETE")
Rel(authService, authRoute, "HTTP POST")
Rel(userService, habitRoute, "HTTP GET/POST")

Rel(authRoute, authController, "delegiert zu")
Rel(habitRoute, habitController, "delegiert zu")

Rel(authController, userModel, "nutzt")
Rel(habitController, habitModel, "nutzt")

Rel(habitModel, prismaClient, "verwendet")
Rel(userModel, prismaClient, "verwendet")

Rel(prismaClient, userTable, "CRUD")
Rel(prismaClient, habitTable, "CRUD")
@enduml
